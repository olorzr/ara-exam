# Supabase 설정
# Supabase 프로젝트 대시보드 > Settings > API에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 네이버 웍스 (LINE WORKS) OAuth
# LINE WORKS Developer Console에서 앱 등록 후 발급
NAVER_WORKS_CLIENT_ID=your-client-id-here
NAVER_WORKS_CLIENT_SECRET=your-client-secret-here

# 앱 origin (프로덕션 필수)
# OAuth redirect_uri 와 콜백 리다이렉트 URL 을 Host 헤더가 아닌 이 고정값으로 만든다.
# Host 헤더 조작으로 인한 redirect_uri 오염 / 매직링크 토큰 유출을 막는다.
# 로컬 개발(NODE_ENV != production)에서만 미설정 시 요청 origin 으로 폴백하므로 비워도 된다.
# 프로덕션에서는 필수 — 미설정이거나 잘못된 값(스킴 누락 등)이면 OAuth 라우트가 500 을 반환한다.
APP_ORIGIN=https://your-app-domain.example.com

# 학원 관리 시스템(ara-system) 성적 자동 등록 브릿지 — **운영 필수**
# 두 값이 있어야 시험 생성·재시험·개념지 저장 때 ara-system 성적에 회차가 자동 등록된다.
# 하나라도 비면 발신 라우트가 503 + 서버 로그 + 화면 경고 토스트로 알리고 등록을 건너뛴다
# (시험 생성·개념지 저장 자체는 정상 동작한다). 연동을 안 쓰는 배포만 비워둘 것.
#
# ARA_SYSTEM_INTAKE_URL  = ara-system 프로덕션 URL. ⚠️ **반드시 www 호스트**.
#   apex(araeducation.co.kr)·admin 서브도메인은 ara-system next.config.ts 가 /api/* 까지
#   www 로 307 리다이렉트하는데, fetch 는 크로스오리진 리다이렉트에서 Authorization 헤더를
#   버리므로 영구 401 이 된다(증상은 '조용히 등록 안 됨').
# ARA_SYSTEM_INTAKE_SECRET = ara-system 의 VOCAB_INTAKE_SECRET 과 **글자 그대로 동일**한 값.
#   붙여넣을 때 끝 공백·줄바꿈이 섞이면 timingSafeEqual 이 길이부터 다르다고 보고 401 이 난다.
#
# 설정 확인(로그인 없이 확인 가능 — 미설정이면 not_configured, 설정됐으면 unauthorized):
#   curl -sS -X POST -H 'content-type: application/json' -d '{}' https://<이 앱 주소>/api/sync-to-grades
ARA_SYSTEM_INTAKE_URL=https://www.araeducation.co.kr
ARA_SYSTEM_INTAKE_SECRET=shared-secret-must-match-ara-system

# 기출 문제 은행 OCR (선택, 기본 꺼짐)
# '1' 또는 'true' 로 두면 /problems/upload 의 AI 읽기와 /settings/ai 화면이 열린다.
# NEXT_PUBLIC_ 접두사를 붙이지 말 것 — 붙이면 값이 번들에 박혀 배포 없이 끄는 킬스위치가 안 된다.
# 클라이언트는 GET /api/ai/status 로 물어본다.
# ⚠️ AI 는 서버가 아니라 **선생님 PC 의 코덱스 브릿지**에서 돈다. 서버는 이 플래그만 판정한다.
# 이 스위치 하나가 세 기능을 함께 연다: 기출 PDF 읽기 · 학교 프린트 스캔 읽기 · 개념지 AI 추천 빈칸
AI_OCR_BETA=
